    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "discord.js": "^14.26.0",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0"
  }
}
