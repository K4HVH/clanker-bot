# ─── clanker-bot environment ───────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values:  cp .env.example .env
# NEVER commit `.env` (it's gitignored). Do NOT paste the token into chat.
# ────────────────────────────────────────────────────────────────────────────

# Bot token — Developer Portal → your app → Bot → "Reset Token" → copy.
# SECRET. Treat like a password; if it ever leaks, reset it in the portal.
DISCORD_TOKEN=

# Application (Client) ID — Developer Portal → General Information → "Application ID".
# Not secret. Needed to register slash commands. Safe to share with me in chat.
DISCORD_APPLICATION_ID=

# Your server's ID — enable Developer Mode (Settings → Advanced), then
# right-click your server icon → "Copy Server ID". Used for instant per-guild
# slash-command registration during development.
DISCORD_GUILD_ID=

# Path to the SQLite database file (created on first run).
DATABASE_PATH=./data/clanker.sqlite

# Application log level: debug | info | warn | error
LOG_LEVEL=info

# How often the scheduler polls for due jobs (temp-ban expiry), in ms (5000-300000).
SCHEDULER_POLL_INTERVAL_MS=30000
